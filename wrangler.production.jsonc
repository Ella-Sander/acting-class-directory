{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acting-class-directory",
  "compatibility_date": "2026-10-23",
  "main": "src/worker.js",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/directory", "/studios", "/classes", "/coaches", "/api/*", "/providers/*", "/classes/*", "/teachers/*", "/sitemap.xml", "/robots.txt"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DIRECTORY_DB",
      "database_name": "acting-class-directory",
      "database_id": "05ca97de-b898-45ab-8740-6f8f1456ef6d",
      "migrations_dir": "migrations"
    }
  ]
}
